{
  // Disable chktex if you don't need it
  "latex-workshop.chktex.enabled": false,

  // Set the PDF viewer
  "latex-workshop.view.pdf.viewer": "tab",

  // Choose your default recipe
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdf)",
      "tools": ["latexmk"]
    }
  ],

  // Optionally set a manual path if pdflatex/latexmk aren't found
  "latex-workshop.latex.path": "C:\\Program Files\\MiKTeX\\miktex\\bin\\x64",

  // Optional — force latexmk to compile using pdf mode
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ]
    }
  ]
}